block vars
  - listSections = []
  - var page = 'checklist'

//- Inject all mixins to be able to call these
include ../mixins/mixins


doctype html
html.no-js(lang=translation.SITE_LANGUAGE, dir=translation.SITE_DIRECTION)
  head

    //- Include the HEAD of the page
    include head
  body

    //- Scripts needed to be load just after the body
    include before-scripts

    //- Website wrapper
    .page-wrapper

      .page-header
        //- Banner shown when JavaScript is disabled
        include ../components/c-top-alert

        include header

      .page-main
        main.s-main#js-main
          block main

      .page-footer
        include footer

    include help

    a.c-coffee(href="https://paystack.shop/pay/gs24kq1bgi" target="_blank" rel="noopener noreferrer" title=translation.ui.COFFEE_TITLE)
      span.c-coffee__icon(aria-hidden="true") ☕
      span.c-coffee__text= translation.ui.COFFEE

    //- Scripts loading
    include after-scripts
