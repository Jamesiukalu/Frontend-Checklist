//- Open Graph / Twitter cards. `pageTitle`, `pageDescription` and
//- `canonicalUrl` are set in head.pug (per page, not just the home page).
//- The share image is the repo's 1200x628 banner (src/img/social/facebook-banner.jpg).
- var shareImageUrl = translation.URL_WEBSITE + '/img/social/facebook-banner.jpg'
- var ogLocale = translation.SITE_LANGUAGE === 'fr' ? 'fr_FR' : 'en_US'
- var ogLocaleAlternate = translation.SITE_LANGUAGE === 'fr' ? 'en_US' : 'fr_FR'
meta(property="og:site_name" content="Front-End Checklist")
meta(property="og:url" content=canonicalUrl)
meta(property="og:type" content="website")
meta(property="og:title" content=pageTitle)
meta(property="og:description" content=pageDescription)
meta(property="og:locale" content=ogLocale)
meta(property="og:locale:alternate" content=ogLocaleAlternate)
meta(property="og:image" content=shareImageUrl)
meta(property="og:image:width" content="1200")
meta(property="og:image:height" content="628")
meta(property="og:image:alt" content=pageTitle)

meta(name="twitter:card" content="summary_large_image")
meta(name="twitter:title" content=pageTitle)
meta(name="twitter:description" content=pageDescription)
meta(name="twitter:image" content=shareImageUrl)
meta(name="twitter:image:alt" content=pageTitle)
