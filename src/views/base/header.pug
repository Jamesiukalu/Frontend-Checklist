.s-topbar
  .s-topbar__inner
    a.s-topbar__brand(href="/")= translation.SITE_NAME

    .s-topbar__actions
      a.s-topbar__link(href="/" hreflang="en" lang="en") EN
      a.s-topbar__link(href="/fr" hreflang="fr" lang="fr") FR
      a.s-topbar__link(href=translation.URL_GITHUB_ROOT target="_blank" rel="noopener noreferrer") GitHub
      button.theme-toggle.js-theme-toggle(type="button" aria-label=translation.ui.THEME_LABEL title=translation.ui.THEME_TITLE)
        svg.theme-toggle__sun(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true")
          circle(cx="12" cy="12" r="4")
          path(d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4")
        svg.theme-toggle__moon(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true")
          path(d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z")

.s-hero
  h1.s-hero__title= translation.SITE_NAME
  p.s-hero__tagline= translation.SITE_TAGLINE
