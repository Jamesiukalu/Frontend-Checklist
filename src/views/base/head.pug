//- SEO: per-page title, description, canonical URL and hreflang.
//- `page` is 'checklist' by default (layout.pug), 'audit' on audit.pug,
//- 'terms' on terms.pug and 'contact' on contact.pug.
- var isAuditPage = typeof page !== 'undefined' && page === 'audit'
- var isTermsPage = typeof page !== 'undefined' && page === 'terms'
- var isContactPage = typeof page !== 'undefined' && page === 'contact'
//- Home path is '/' in English but '/fr' in French: vercel.json sets
//- trailingSlash: false, so /fr/ redirects to /fr and must never be a
//- canonical / hreflang target. Sub-page paths are slash-free in both languages.
- var pageSlug = isAuditPage ? 'audit' : isTermsPage ? 'terms' : isContactPage ? 'contact' : ''
- var enPath = pageSlug ? '/' + pageSlug : '/'
- var frPath = pageSlug ? '/fr/' + pageSlug : '/fr'
- var canonicalUrl = translation.URL_WEBSITE + (translation.SITE_LANGUAGE === 'en' ? enPath : frPath)
- var pageTitle = isAuditPage ? translation.AUDIT_SEO_TITLE : isTermsPage ? translation.terms.SEO_TITLE : isContactPage ? translation.contact.SEO_TITLE : translation.SEO_TITLE
- var pageDescription = isAuditPage ? translation.AUDIT_SEO_DESCRIPTION : isTermsPage ? translation.terms.SEO_DESCRIPTION : isContactPage ? translation.contact.SEO_DESCRIPTION : translation.SEO_DESCRIPTION

<!-- Analytics disabled: no-op so existing gtag() event calls don't throw. Replace with your own GA4 snippet if wanted. -->
script.
  window.gtag = window.gtag || function () {};

<!-- Set character encoding for the document -->
meta(charset="utf-8")

<!-- Instruct Internet Explorer to use its latest rendering engine -->
meta(http-equiv="x-ua-compatible", content="ie=edge")

<!-- Viewport for responsive web design -->
meta(name='viewport', content='width=device-width, initial-scale=1')

<!-- Document Title -->
title= pageTitle

<!-- Meta Description -->
meta(name='description', content=pageDescription)

<!-- Canonical URL (one per page: the audit page no longer shares the home page's) -->
link(rel="canonical", href=canonicalUrl)

<!-- Alternate language versions -->
link(rel="alternate", hreflang="en", href=translation.URL_WEBSITE + enPath)
link(rel="alternate", hreflang="fr", href=translation.URL_WEBSITE + frPath)
link(rel="alternate", hreflang="x-default", href=translation.URL_WEBSITE + enPath)

//- Set the theme before first paint to avoid a flash of the wrong theme
script.
  (function () {
    var theme;
    try { theme = localStorage.getItem('theme'); } catch (e) {}
    if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', theme);
  })();

//- Plain stylesheet link: Beasties inlines the critical CSS from it
//- (gulpfile: preload: false). The old preload + onload + <noscript>
//- pattern hid the inlined CSS inside <noscript> (dead code, invisible
//- to static analysis) and the onload handler tripped the no-inline-JS check.
link(rel="stylesheet" href="/styles/main.min.css?v=" + ASSET_VERSION)

<!-- Recommended favicon format -->
link(rel="icon", type="image/png", sizes="32x32", href="/favicon-32x32.png")
link(rel="icon", type="image/png", sizes="16x16", href="/favicon-16x16.png")

<!-- Apple Touch Icon -->
link(rel="apple-touch-icon", sizes="180x180", href="/apple-touch-icon.png")

<!-- Microsoft Tiles -->
meta(name="msapplication-config" content="/browserconfig.xml")

link(rel="mask-icon", href="/safari-pinned-tab.svg", color="#5bbad5")
meta(name="theme-color" content="#2b2b2b")
meta(name="msapplication-TileColor" content="#2b2b2b")
meta(name="msapplication-TileImage" content="/icons/mstile-144x144.png")

link(rel="manifest" href="/manifest.json")

include social
include jsonld

script
  include ../../modernizr-custom.min.js
