extends base/layout

block vars
  - listSections = []
  - var page = 'audit'

block main
  .s-audit
    header.s-audit__hero
      h1.s-audit__title= translation.audit.TITLE
      p.s-audit__lead= translation.audit.LEAD

    section.c-audit
      form.c-audit__form.js-audit-form(novalidate)
        label.c-audit__label(for="audit-url")= translation.audit.LABEL
        .c-audit__row
          input#audit-url.c-audit__input(type="text" name="url" inputmode="url" autocomplete="url" placeholder="example.com" required)
          button.button.--fill.c-audit__submit.js-audit-submit(type="submit")= translation.audit.BUTTON

      p.c-audit__status.js-audit-status(role="status" aria-live="polite")

    section.c-audit-results.js-audit-results(hidden)
      - var brand = translation.audit
      a.c-brand(href=brand.BRAND_URL target="_blank" rel="noopener")
        img.c-brand__logo(src="/img/brand/shinning-tech.jpg" alt="" width="44" height="44")
        span.c-brand__text
          strong= brand.BRAND_NAME
          span= brand.BRAND_TAGLINE + ' · ' + brand.BRAND_HOST

      .c-audit__summary
        strong.c-audit__score.js-audit-score
        span.c-audit__counts.js-audit-counts

      .c-audit__actions
        button.button.--fill.js-audit-apply(type="button")= translation.audit.APPLY
        a.c-audit__link.js-audit-open(href=(translation.SITE_LANGUAGE === 'en' ? '' : '/' + translation.SITE_LANGUAGE) + '/')= translation.audit.VIEW_CHECKLIST
        button.button.js-audit-export(type="button" data-action="download")= translation.audit.EXPORT_MD
        button.button.js-audit-export(type="button" data-action="copy-md")= translation.audit.COPY_MD
        button.button.js-audit-export(type="button" data-action="copy-link")= translation.audit.COPY_LINK
        button.button.js-audit-export(type="button" data-action="print")= translation.audit.PRINT
        span.c-audit__applied.js-audit-applied(role="status" aria-live="polite")

      h2.c-audit__heading= translation.audit.FAILED_HEADING
      ul.c-audit__list.js-audit-failed
      h2.c-audit__heading= translation.audit.PASSED_HEADING
      ul.c-audit__list.c-audit__list--passed.js-audit-passed

      section.c-audit__about
        h2.c-audit__heading= brand.REPORT_ABOUT_HEADING
        p= brand.REPORT_DISCLAIMER
        p= brand.HEURISTIC_NOTE
        h3.c-audit__subheading= brand.LIMITS_HEADING
        ul.c-audit__limits
          each limit in brand.LIMITS
            li= limit
        h3.c-audit__subheading= brand.NOT_CHECKED_HEADING
        p= brand.NOT_CHECKED_INTRO
        ul.c-audit__list.c-audit__list--plain.js-audit-notchecked

      a.c-brand.c-brand--cta(href=brand.BRAND_URL target="_blank" rel="noopener")
        img.c-brand__logo(src="/img/brand/shinning-tech.jpg" alt="" width="44" height="44")
        span.c-brand__text
          strong= brand.BRAND_CTA
          span= brand.BRAND_HOST

    p.c-audit__note= translation.audit.NOTE

  script#js-audit-labels(type="application/json")!= JSON.stringify(translation.audit)
