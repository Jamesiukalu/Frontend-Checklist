extends base/layout

//- Block main
block main

  include components/s-section-top

  //- Sections, in display order. The sidebar nav is built from this list.
  -
    var sections = [
      ['利用方法', '利用方法'],
    ];
    listSections = sections.map(function (s) { return s[1].toLowerCase(); });

  .s-layout

    aside.s-sidebar
      include components/c-nav

    .s-content

      //- _items is in the JSON injected in the view with gulp-data (called _project.json)
      .s-main__section.s-main__filter
        include components/c-tag-filter

      .s-main__section.s-main__checklist

        if _items !== undefined

          each section in sections
            +checklist-section({
              dataSection: _items[section[0]],
              sectionTitle: section[1]
            })

      include components/c-report
