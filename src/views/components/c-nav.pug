nav.c-nav(aria-label=translation.ui.NAV_LABEL)
  ul.c-nav__list

    each section in sections
      - var anchor = section[1].toLowerCase()
      li.c-nav__item
        a.c-nav__link(href=`#section-${anchor}`)
          span.c-nav__status(id=`js-nav-${anchor}`, data-notation="0")
          span.c-nav__label= section[1]
