section.c-audit#audit
  h2.c-audit__title= translation.audit.TITLE
  p.c-audit__lead= translation.audit.LEAD

  form.c-audit__form.js-audit-form(novalidate)
    label.c-audit__label(for="audit-url")= translation.audit.LABEL
    .c-audit__row
      input#audit-url.c-audit__input(type="text" name="url" inputmode="url" autocomplete="url" placeholder="example.com" required)
      button.button.--fill.c-audit__submit.js-audit-submit(type="submit")= translation.audit.BUTTON

  p.c-audit__status.js-audit-status(role="status" aria-live="polite")

  .c-audit__summary.js-audit-summary(hidden)
    strong.c-audit__score.js-audit-score
    span.c-audit__counts.js-audit-counts
    button.c-audit__clear.js-audit-clear(type="button")= translation.audit.CLEAR
  script#js-audit-labels(type="application/json")!= JSON.stringify(translation.audit)
