.c-tools

  .c-button__group
    button.c-button-icon.js-check-all(title=translation.ui.CHECK_ALL)
      +svg-icon.icon.icon-check(data-icon-name='check')

    button.c-button-icon.js-uncheck-all(title=translation.ui.UNCHECK_ALL)
      +svg-icon.icon.icon-uncheck(data-icon-name='check')

  .c-button__group
    button.c-button-icon.js-expand-all(title=translation.ui.EXPAND_ALL)
      +svg-icon.icon.icon-check(data-icon-name='expand')

    button.c-button-icon.js-collapse-all(title=translation.ui.COLLAPSE_ALL)
      +svg-icon.icon.icon-uncheck(data-icon-name='collapse')

  .c-button__group
    button.c-button-icon.js-hide-section(title=translation.ui.HIDE_SECTION)
      +svg-icon.icon.icon-eye(data-icon-name='eye')
